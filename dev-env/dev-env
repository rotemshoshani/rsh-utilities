#!/usr/bin/env bash
# dev-env — tmux session with controller bar + two dev-server panes.
#
# Layout (vertical stack — native OS mouse copy works per pane):
#   ┌─────────────────────────────┐
#   │  controller (single row)    │
#   ├─────────────────────────────┤
#   │  TOP cmd                    │
#   ├─────────────────────────────┤
#   │  BOTTOM cmd                 │
#   └─────────────────────────────┘
#
# Defaults: TOP='npx convex dev', BOTTOM='npm run dev'.

set -euo pipefail

TOP_CMD="npx convex dev"
BOT_CMD="npm run dev"
PULL_WATCH=0
SYNC_WATCH=0
REPAIR_DEPENDENCIES=0
AUTO_RECOVER=0
PULL_REMOTE="origin"
PULL_BRANCH="dev"
PULL_INTERVAL=30
RESTART_HOURS="3"
RESTART_SECONDS="10800"
UAT_PORT=0
ATTACH_UAT=0

set_uat_port() {
  [[ "$1" =~ ^[0-9]{1,5}$ ]] && (( 10#$1 >= 1024 && 10#$1 <= 65535 )) || {
    echo 'dev-env: UAT port must be between 1024 and 65535' >&2; return 1;
  }
  UAT_PORT="$((10#$1))"
}

start_uat_listener() {
  [[ "$UAT_PORT" != 0 ]] || return 0
  local listener="$UTILITIES_ROOT/agent-time/agent-time" state command
  # Port health contains only our service marker and project path. Never reuse
  # another project's listener, or restart an unrelated process to claim a port.
  state=$(PYTHONPATH="$UTILITIES_ROOT/agent-time/src" python3 - "$PROJ_DIR" "$UAT_PORT" <<'PY'
import json, socket, sys, urllib.request
from agent_time.core import project_for
port = int(sys.argv[2])
with socket.socket() as sock:
    try:
        sock.bind(('127.0.0.1', port))
        print('new')
        sys.exit(0)
    except OSError:
        pass
try:
    with urllib.request.urlopen(f'http://127.0.0.1:{port}/health', timeout=1) as response:
        data = json.loads(response.read(4096))
    if data.get('service') == 'agent-time-uat' and data.get('project') == project_for(sys.argv[1]):
        print('existing')
        sys.exit(0)
except Exception:
    pass
print('dev-env: UAT port is occupied by another service or project', file=sys.stderr)
sys.exit(1)
PY
  ) || return 1
  if [[ "$state" == new ]]; then
    command=$(printf '%q serve --project %q --port %q' "$listener" "$PROJ_DIR" "$UAT_PORT")
    tmux new-window -d -t "$SESSION" -n agent-time-uat -c "$PROJ_DIR" "$command"
  fi
  tmux set-environment -t "$SESSION" AGENT_TIME_UAT_PORT "$UAT_PORT"
}

canonical_dir() {
  (cd "$1" && pwd -P)
}

set_restart_hours() {
  local hours="$1"

  if [[ "$hours" == "off" ]]; then
    RESTART_HOURS="off"
    RESTART_SECONDS="0"
    return 0
  fi
  if [[ ! "$hours" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    echo "dev-env: restart hours must be a positive number or 'off'" >&2
    return 1
  fi
  if ! RESTART_SECONDS=$(awk -v hours="$hours" 'BEGIN {
    seconds = hours * 3600
    if (seconds < 1) exit 1
    printf "%.0f\\n", seconds
  }'); then
    echo "dev-env: restart hours must be at least one second" >&2
    return 1
  fi
  RESTART_HOURS="$hours"
}

set_mode() {
  case "$1" in
    normal) PULL_WATCH=0; SYNC_WATCH=0; AUTO_RECOVER=0 ;;
    pull)   PULL_WATCH=1; SYNC_WATCH=0; AUTO_RECOVER=0 ;;
    sync)   PULL_WATCH=1; SYNC_WATCH=1; AUTO_RECOVER=1 ;;
    *) echo "dev-env: mode must be normal, pull, or sync" >&2; return 1 ;;
  esac
}

load_project_config() {
  local config_path="$1" config_output key value
  [[ -f "$config_path" ]] || return 0
  command -v python3 >/dev/null 2>&1 || {
    echo "dev-env: python3 is required to read $config_path" >&2
    return 1
  }
  config_output="$(mktemp)"
  if ! python3 "$2" "$config_path" dev_env >"$config_output"; then
    rm -f "$config_output"
    return 1
  fi
  while IFS= read -r -d '' key && IFS= read -r -d '' value; do
    case "$key" in
      top_command) TOP_CMD="$value" ;;
      bottom_command) BOT_CMD="$value" ;;
      mode) set_mode "$value" || { rm -f "$config_output"; return 1; } ;;
      repair) [[ "$value" == "true" ]] && REPAIR_DEPENDENCIES=1 || REPAIR_DEPENDENCIES=0 ;;
      remote) PULL_REMOTE="$value" ;;
      branch) PULL_BRANCH="$value" ;;
      interval_seconds) PULL_INTERVAL="$value" ;;
      restart_hours) set_restart_hours "$value" || { rm -f "$config_output"; return 1; } ;;
      uat_port) UAT_PORT="$value" ;;
    esac
  done <"$config_output"
  rm -f "$config_output"
}

process_cwd() {
  local pid="$1"

  if [[ -L "/proc/$pid/cwd" ]]; then
    readlink -f "/proc/$pid/cwd" 2>/dev/null
    return
  fi

  if command -v lsof >/dev/null 2>&1; then
    lsof -a -d cwd -Fn -p "$pid" 2>/dev/null | sed -n 's/^n//p' | head -n1
  fi
}

process_command() {
  ps -p "$1" -o args= 2>/dev/null || true
}

process_is_running() {
  local stat
  stat="$(ps -p "$1" -o stat= 2>/dev/null || true)"

  [[ -n "$stat" && "$stat" != Z* ]]
}

is_project_dev_command() {
  local cmd="$1"

  case "$cmd" in
    *"npm run dev"*|*"npx convex dev"*|*"convex dev"*|*"next dev"*|*"next-server"*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

cleanup_project_dev_processes() {
  local project_dir
  project_dir="$(canonical_dir "$1")"

  local self_pid="$$"
  local parent_pid="${PPID:-}"
  local pid cmd cwd
  local killed_pids=()

  while IFS= read -r pid; do
    pid="${pid//[[:space:]]/}"
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    [[ "$pid" == "$self_pid" || "$pid" == "$parent_pid" ]] && continue

    cmd="$(process_command "$pid")"
    [[ -n "$cmd" ]] || continue
    is_project_dev_command "$cmd" || continue

    cwd="$(process_cwd "$pid")"
    [[ "$cwd" == "$project_dir" ]] || continue

    printf 'dev-env: stopping existing dev process %s (%s)\n' "$pid" "$cmd" >&2
    kill "$pid" 2>/dev/null || true
    killed_pids+=("$pid")
  done < <(ps -eo pid= 2>/dev/null)

  for pid in "${killed_pids[@]}"; do
    for _ in {1..20}; do
      process_is_running "$pid" || break
      sleep 0.1
    done

    if process_is_running "$pid"; then
      printf 'dev-env: force-stopping existing dev process %s\n' "$pid" >&2
      kill -KILL "$pid" 2>/dev/null || true
    fi
  done
}

cleanup_tmux_session() {
  local session="$1"

  if tmux has-session -t "$session" 2>/dev/null; then
    printf 'dev-env: killing existing tmux session %s\n' "$session" >&2
    tmux kill-session -t "$session"
  fi
}

timestamp() {
  date '+%Y-%m-%d %H:%M:%S'
}

dependency_fingerprint() {
  local project_dir="$1"
  local dependency_files=()
  local candidate

  for candidate in package.json package-lock.json npm-shrinkwrap.json pnpm-lock.yaml yarn.lock bun.lock bun.lockb; do
    [[ -f "$project_dir/$candidate" ]] && dependency_files+=("$candidate")
  done

  ((${#dependency_files[@]} > 0)) || return 1

  (
    cd "$project_dir"
    cksum "${dependency_files[@]}"
  ) | cksum | awk '{ print $1 ":" $2 }'
}

dependency_manager() {
  local project_dir="$1"

  if [[ -f "$project_dir/package-lock.json" || -f "$project_dir/npm-shrinkwrap.json" ]]; then
    printf 'npm\n'
  elif [[ -f "$project_dir/pnpm-lock.yaml" ]]; then
    printf 'pnpm\n'
  elif [[ -f "$project_dir/yarn.lock" ]]; then
    printf 'yarn\n'
  elif [[ -f "$project_dir/bun.lock" || -f "$project_dir/bun.lockb" ]]; then
    printf 'bun\n'
  else
    return 1
  fi
}

dependency_stamp_file() {
  printf '%s/dependencies.fingerprint\n' "$1"
}

dependencies_need_install() {
  local project_dir="$1"
  local state_dir="$2"
  local fingerprint stamp_file installed_fingerprint=""

  fingerprint="$(dependency_fingerprint "$project_dir" 2>/dev/null || true)"
  [[ -n "$fingerprint" ]] || return 1

  stamp_file="$(dependency_stamp_file "$state_dir")"
  if [[ -f "$stamp_file" ]]; then
    IFS= read -r installed_fingerprint <"$stamp_file" || true
  fi

  [[ ! -d "$project_dir/node_modules" || "$installed_fingerprint" != "$fingerprint" ]]
}

write_dependency_stamp() {
  local project_dir="$1"
  local state_dir="$2"
  local fingerprint stamp_file temporary_stamp

  fingerprint="$(dependency_fingerprint "$project_dir")"
  stamp_file="$(dependency_stamp_file "$state_dir")"
  temporary_stamp="${stamp_file}.tmp.$$"

  mkdir -p "$state_dir"
  (umask 077 && printf '%s\n' "$fingerprint" >"$temporary_stamp")
  mv "$temporary_stamp" "$stamp_file"
}

install_dependencies() {
  local project_dir="$1"
  local state_dir="$2"
  local manager yarn_major

  manager="$(dependency_manager "$project_dir" 2>/dev/null || true)"
  if [[ -z "$manager" ]]; then
    printf 'dev-env: no supported lockfile found; skipping dependency install\n'
    return 0
  fi

  printf '[%s] dev-env: rebuilding dependencies with %s\n' "$(timestamp)" "$manager"
  (
    cd "$project_dir"
    case "$manager" in
      npm)
        command -v npm >/dev/null 2>&1 || { echo "dev-env: npm is not installed" >&2; exit 1; }
        npm ci
        ;;
      pnpm)
        command -v pnpm >/dev/null 2>&1 || { echo "dev-env: pnpm is not installed" >&2; exit 1; }
        pnpm install --frozen-lockfile
        ;;
      yarn)
        command -v yarn >/dev/null 2>&1 || { echo "dev-env: yarn is not installed" >&2; exit 1; }
        yarn_major="$(yarn --version | cut -d. -f1)"
        if [[ "$yarn_major" =~ ^[0-9]+$ ]] && (( yarn_major >= 2 )); then
          yarn install --immutable
        else
          yarn install --frozen-lockfile
        fi
        ;;
      bun)
        command -v bun >/dev/null 2>&1 || { echo "dev-env: bun is not installed" >&2; exit 1; }
        bun install --frozen-lockfile
        ;;
    esac
  )
  write_dependency_stamp "$project_dir" "$state_dir"
  printf '[%s] dev-env: dependencies are synchronized\n' "$(timestamp)"
}

verify_dependency_cache() {
  local project_dir="$1"
  local manager

  manager="$(dependency_manager "$project_dir" 2>/dev/null || true)"
  case "$manager" in
    npm)
      printf '[%s] dev-env: verifying npm cache\n' "$(timestamp)"
      (cd "$project_dir" && npm cache verify)
      ;;
    pnpm)
      printf '[%s] dev-env: checking pnpm store\n' "$(timestamp)"
      (cd "$project_dir" && pnpm store status)
      ;;
    yarn|bun)
      printf 'dev-env: %s has no safe generic cache verification step; continuing with a frozen install\n' "$manager"
      ;;
    *)
      printf 'dev-env: no supported lockfile found; skipping cache verification\n'
      ;;
  esac
}

tmux_environment_value() {
  local session="$1"
  local name="$2"

  tmux show-environment -t "$session" "$name" 2>/dev/null | cut -d= -f2- || true
}

pause_workers() {
  local session="$1"
  local top_id bot_id paused_run

  top_id="$(tmux_environment_value "$session" DEV_TOP_ID)"
  bot_id="$(tmux_environment_value "$session" DEV_BOT_ID)"
  paused_run="$(tmux_environment_value "$session" DEV_PAUSED_RUN)"

  printf '[%s] dev-env: pausing dev servers for dependency installation\n' "$(timestamp)"
  [[ -n "$top_id" && -n "$paused_run" ]] && tmux respawn-pane -k -t "$top_id" "$paused_run"
  [[ -n "$bot_id" && -n "$paused_run" ]] && tmux respawn-pane -k -t "$bot_id" "$paused_run"
  return 0
}

restart_workers() {
  local session="$1"
  local top_id bot_id top_run bot_run

  top_id="$(tmux_environment_value "$session" DEV_TOP_ID)"
  bot_id="$(tmux_environment_value "$session" DEV_BOT_ID)"
  top_run="$(tmux_environment_value "$session" DEV_TOP_RUN)"
  bot_run="$(tmux_environment_value "$session" DEV_BOT_RUN)"

  printf '[%s] dev-env: restarting dev servers\n' "$(timestamp)"
  [[ -n "$top_id" && -n "$top_run" ]] && tmux respawn-pane -k -t "$top_id" "$top_run"
  [[ -n "$bot_id" && -n "$bot_run" ]] && tmux respawn-pane -k -t "$bot_id" "$bot_run"
  return 0
}

pull_once() {
  local project_dir="$1"
  local remote="$2"
  local branch="$3"
  local current_branch local_ref remote_ref

  (
    cd "$project_dir"

    printf '\n[%s] dev-env: checking gh in...\n' "$(timestamp)"
    printf '[%s] dev-env: fetching %s/%s\n' "$(timestamp)" "$remote" "$branch"
    git fetch "$remote" "+refs/heads/$branch:refs/remotes/$remote/$branch"
    git status --short --branch

    current_branch="$(git branch --show-current 2>/dev/null || true)"
    if [[ "$current_branch" != "$branch" ]]; then
      printf 'dev-env: current branch is %s; skipping automatic pull for %s\n' "${current_branch:-detached}" "$branch"
      return 0
    fi

    local_ref="$(git rev-parse --verify "$branch" 2>/dev/null || true)"
    remote_ref="$(git rev-parse --verify "$remote/$branch" 2>/dev/null || true)"
    if [[ -z "$local_ref" || -z "$remote_ref" || "$local_ref" == "$remote_ref" ]]; then
      return 0
    fi

    printf 'dev-env: diff found - pulling...\n'
    printf 'dev-env: %s/%s changed; fast-forwarding %s\n' "$remote" "$branch" "$branch"
    git pull --ff-only "$remote" "$branch"
    printf 'dev-env: pull finished\n'
    git status --short --branch
  )
}

sync_once() {
  local project_dir="$1"
  local remote="$2"
  local branch="$3"
  local session="$4"
  local state_dir="$5"
  local current_branch local_ref remote_ref changed_files=""
  local pulled=0 restarted=0

  (
    cd "$project_dir"

    printf '\n[%s] dev-env: checking gh in...\n' "$(timestamp)"
    printf '[%s] dev-env: fetching %s/%s\n' "$(timestamp)" "$remote" "$branch"
    git fetch "$remote" "+refs/heads/$branch:refs/remotes/$remote/$branch"

    current_branch="$(git branch --show-current 2>/dev/null || true)"
    if [[ "$current_branch" != "$branch" ]]; then
      printf 'dev-env: current branch is %s; skipping automatic sync for %s\n' "${current_branch:-detached}" "$branch"
      git status --short --branch
      return 0
    fi

    local_ref="$(git rev-parse --verify "$branch" 2>/dev/null || true)"
    remote_ref="$(git rev-parse --verify "$remote/$branch" 2>/dev/null || true)"

    if [[ -n "$local_ref" && -n "$remote_ref" && "$local_ref" != "$remote_ref" ]]; then
      if git merge-base --is-ancestor "$local_ref" "$remote_ref"; then
        changed_files="$(git diff --name-only "$local_ref" "$remote_ref")"
        printf 'dev-env: diff found - pulling...\n'
        printf 'dev-env: %s/%s changed; fast-forwarding %s\n' "$remote" "$branch" "$branch"
        git pull --ff-only "$remote" "$branch"
        printf 'dev-env: pull finished\n'
        pulled=1
      elif git merge-base --is-ancestor "$remote_ref" "$local_ref"; then
        printf 'dev-env: local %s is ahead of %s/%s; leaving it unchanged\n' "$branch" "$remote" "$branch"
      else
        printf 'dev-env: local %s and %s/%s diverged; refusing automatic reconciliation\n' "$branch" "$remote" "$branch" >&2
        git status --short --branch
        return 1
      fi
    fi

    if dependencies_need_install "$project_dir" "$state_dir"; then
      pause_workers "$session"
      if install_dependencies "$project_dir" "$state_dir"; then
        restart_workers "$session"
        restarted=1
      else
        printf 'dev-env: dependency installation failed; dev servers remain paused and sync will retry\n' >&2
        return 1
      fi
    fi

    if [[ "$pulled" == "1" && "$restarted" == "0" ]] &&
       grep -Eq '(^|/)(next\.config\.[^/]+|tsconfig\.json|convex\.json|middleware\.[^/]+|proxy\.[^/]+|\.nvmrc|\.node-version)$' <<<"$changed_files"; then
      printf 'dev-env: runtime configuration changed\n'
      restart_workers "$session"
    fi

    git status --short --branch
  )
}

pull_watcher() {
  local project_dir="$1"
  local remote="$2"
  local branch="$3"
  local interval="$4"

  while true; do
    pull_once "$project_dir" "$remote" "$branch" || true
    sleep "$interval"
  done
}

sync_watcher() {
  local project_dir="$1"
  local remote="$2"
  local branch="$3"
  local interval="$4"
  local session="$5"
  local state_dir="$6"

  while true; do
    sync_once "$project_dir" "$remote" "$branch" "$session" "$state_dir" || true
    sleep "$interval"
  done
}

# ---- Runner subcommand (wraps each worker pane) ------------------------------
# Keeps the pane alive after the command exits/crashes, so the user can read
# the final output and restart it via the controller. Avoids the race where
# `remain-on-exit on` is set too late.
if [[ "${1:-}" == "__runner" ]]; then
  shift
  command_to_run="$1"
  auto_recover="${2:-0}"
  set +e

  if [[ "$auto_recover" != "1" ]]; then
    bash -c "$command_to_run"
    ec=$?
    printf '\n\033[1;31m[exited code=%d]\033[0m  Use the controller above to restart.\n' "$ec"
    while true; do sleep 3600; done
  fi

  recovery_delay=5
  while true; do
    started_at="$(date +%s)"
    bash -c "$command_to_run"
    ec=$?
    runtime=$(( $(date +%s) - started_at ))
    if (( runtime >= 60 )); then
      recovery_delay=5
    fi
    printf '\n\033[1;31m[exited code=%d]\033[0m  Auto-restarting in %ss.\n' "$ec" "$recovery_delay"
    sleep "$recovery_delay"
    if (( recovery_delay < 120 )); then
      recovery_delay=$(( recovery_delay * 2 ))
      (( recovery_delay > 120 )) && recovery_delay=120
    fi
  done
fi

if [[ "${1:-}" == "__paused" ]]; then
  printf '\033[1;33mdev-env: paused while dependencies are synchronized\033[0m\n'
  while true; do sleep 3600; done
fi

if [[ "${1:-}" == "__cleanup_project_dev_processes" ]]; then
  shift
  [[ $# -eq 1 ]] || { echo "__cleanup_project_dev_processes needs PROJECT_DIR" >&2; exit 1; }
  cleanup_project_dev_processes "$1"
  exit 0
fi

if [[ "${1:-}" == "__cleanup_tmux_session" ]]; then
  shift
  [[ $# -eq 1 ]] || { echo "__cleanup_tmux_session needs SESSION" >&2; exit 1; }
  cleanup_tmux_session "$1"
  exit 0
fi

if [[ "${1:-}" == "__pull_once" ]]; then
  shift
  [[ $# -eq 3 ]] || { echo "__pull_once needs PROJECT_DIR REMOTE BRANCH" >&2; exit 1; }
  pull_once "$1" "$2" "$3"
  exit 0
fi

if [[ "${1:-}" == "__pull_watcher" ]]; then
  shift
  [[ $# -eq 4 ]] || { echo "__pull_watcher needs PROJECT_DIR REMOTE BRANCH INTERVAL" >&2; exit 1; }
  pull_watcher "$1" "$2" "$3" "$4"
  exit 0
fi

if [[ "${1:-}" == "__sync_once" ]]; then
  shift
  [[ $# -eq 5 ]] || { echo "__sync_once needs PROJECT_DIR REMOTE BRANCH SESSION STATE_DIR" >&2; exit 1; }
  sync_once "$1" "$2" "$3" "$4" "$5"
  exit 0
fi

if [[ "${1:-}" == "__sync_watcher" ]]; then
  shift
  [[ $# -eq 6 ]] || { echo "__sync_watcher needs PROJECT_DIR REMOTE BRANCH INTERVAL SESSION STATE_DIR" >&2; exit 1; }
  sync_watcher "$1" "$2" "$3" "$4" "$5" "$6"
  exit 0
fi

PROJ_DIR="$(pwd)"
SELF="$(readlink -f "$0")"
UTILITIES_ROOT="$(cd "$(dirname "$SELF")/.." && pwd -P)"
load_project_config "$PROJ_DIR/.rsh-utils.json" "$UTILITIES_ROOT/shared/project_config.py"

[[ -v DEV_ENV_TOP ]] && TOP_CMD="$DEV_ENV_TOP"
[[ -v DEV_ENV_BOTTOM ]] && BOT_CMD="$DEV_ENV_BOTTOM"
[[ -v DEV_ENV_MODE ]] && set_mode "$DEV_ENV_MODE"
if [[ -v DEV_ENV_REPAIR ]]; then
  case "$DEV_ENV_REPAIR" in true|1) REPAIR_DEPENDENCIES=1 ;; false|0) REPAIR_DEPENDENCIES=0 ;; *) echo "dev-env: DEV_ENV_REPAIR must be true/false or 1/0" >&2; exit 1 ;; esac
fi
[[ -v DEV_ENV_PULL_REMOTE ]] && PULL_REMOTE="$DEV_ENV_PULL_REMOTE"
[[ -v DEV_ENV_PULL_BRANCH ]] && PULL_BRANCH="$DEV_ENV_PULL_BRANCH"
if [[ -v DEV_ENV_PULL_INTERVAL ]]; then
  [[ "$DEV_ENV_PULL_INTERVAL" =~ ^[0-9]+$ ]] && (( 10#$DEV_ENV_PULL_INTERVAL >= 5 )) || { echo "dev-env: DEV_ENV_PULL_INTERVAL must be a whole number of at least 5" >&2; exit 1; }
  PULL_INTERVAL="$((10#$DEV_ENV_PULL_INTERVAL))"
fi
[[ -v DEV_ENV_RESTART_HOURS ]] && set_restart_hours "$DEV_ENV_RESTART_HOURS"
[[ -v DEV_ENV_UAT_PORT ]] && set_uat_port "$DEV_ENV_UAT_PORT"

usage() {
  cat <<EOF
Usage: dev-env [--pull | --sync | --no-pull | --no-sync] [--interval SECONDS] [--repair | --no-repair]
               [--override CMD1 CMD2] [--restart HOURS | --no-restart]

Spawns a tmux session for the current directory:
  - row 0 (top):    controller bar — single-keypress menu
  - middle pane:    TOP command    (default: npx convex dev)
  - bottom pane:    BOTTOM command (default: npm run dev)

Controller keys (focus the controller pane, then press):
  T = restart TOP    B = restart BOTTOM    A = restart BOTH    Q = kill all

Options:
  --pull                 Watch origin/dev every 30s and fast-forward dev.
  --sync                 Pull like --pull, install changed dependencies, restart
                         for runtime-config changes, and recover crashed workers.
  --no-pull, --no-sync   Disable a pull/sync mode selected by project config.
  --interval SECONDS     Poll interval for --pull/--sync (default: 30, minimum: 5).
  --repair               Verify the package-manager cache and rebuild dependencies
                         before starting the dev environment.
  --no-repair            Skip repair selected by project config.
  --override CMD1 CMD2   Override the top/bottom commands.
  --restart HOURS        Restart both commands every HOURS hours (default: 3).
  --no-restart           Disable automatic restarts.
  --uat-port PORT        Start a loopback agent-time UAT listener for this project.
  --no-uat               Disable UAT collection selected by project config.
  --attach-uat           Add listener to the existing session; restart only BOTTOM.
  -h, --help             Show this help.

Project config: .rsh-utils.json in the current directory. CLI > environment > config > defaults.
Env: DEV_ENV_TOP, DEV_ENV_BOTTOM, DEV_ENV_MODE, DEV_ENV_REPAIR,
     DEV_ENV_PULL_REMOTE, DEV_ENV_PULL_BRANCH, DEV_ENV_PULL_INTERVAL, DEV_ENV_RESTART_HOURS,
     DEV_ENV_UAT_PORT.

Re-running in a directory with an existing session replaces it with a fresh one.
EOF
}

# ---- Controller subcommand (runs inside the tmux pane) -----------------------
if [[ "${1:-}" == "__controller" ]]; then
  session="$2"
  restart_seconds="${3:-0}"
  restart_hours="${4:-}"
  restart_deadline=0

  # If the controller exits for any reason, take the whole session with it.
  trap 'tmux kill-session -t "$session" 2>/dev/null || true' EXIT

  # Parent sets DEV_TOP_ID/etc. shortly after spawning this pane; tolerate the
  # brief window where show-environment returns non-zero.
  set +e
  set +o pipefail

  # ANSI helpers
  ESC=$'\033'
  CLR="${ESC}[2J${ESC}[H"   # clear screen + home
  BOLD="${ESC}[1m"
  DIM="${ESC}[2m"
  CYAN="${ESC}[36m"
  RED="${ESC}[31m"
  RESET="${ESC}[0m"

  render() {
    local top_cmd="$1" bot_cmd="$2" restart_label="$3" sync_label="$4"
    printf '%s' "$CLR"
    printf '%sdev-env%s  ' "$BOLD$CYAN" "$RESET"
    printf '%s[T]%s top (%s)   ' "$BOLD" "$RESET" "$top_cmd"
    printf '%s[B]%s bottom (%s)   ' "$BOLD" "$RESET" "$bot_cmd"
    printf '%s[A]%s both   ' "$BOLD" "$RESET"
    printf '%sauto:%s%s   ' "$DIM" "$restart_label" "$RESET"
    printf '%ssync:%s%s   ' "$DIM" "$sync_label" "$RESET"
    printf '%s[Q]%s kill' "$BOLD$RED" "$RESET"
  }

  restart_both() {
    [[ -n "$top_id" && -n "$top_run" ]] && tmux respawn-pane -k -t "$top_id" "$top_run"
    [[ -n "$bot_id" && -n "$bot_run" ]] && tmux respawn-pane -k -t "$bot_id" "$bot_run"
  }

  if [[ "$restart_seconds" =~ ^[0-9]+$ ]] && (( restart_seconds > 0 )); then
    restart_deadline=$(( $(date +%s) + restart_seconds ))
    restart_label="${restart_hours}h"
  else
    restart_label="off"
  fi

  while true; do
    top_id=$(tmux show-environment -t "$session" DEV_TOP_ID 2>/dev/null | cut -d= -f2-)
    bot_id=$(tmux show-environment -t "$session" DEV_BOT_ID 2>/dev/null | cut -d= -f2-)
    top_cmd=$(tmux show-environment -t "$session" DEV_TOP_CMD 2>/dev/null | cut -d= -f2-)
    bot_cmd=$(tmux show-environment -t "$session" DEV_BOT_CMD 2>/dev/null | cut -d= -f2-)
    top_run=$(tmux show-environment -t "$session" DEV_TOP_RUN 2>/dev/null | cut -d= -f2-)
    bot_run=$(tmux show-environment -t "$session" DEV_BOT_RUN 2>/dev/null | cut -d= -f2-)
    sync_label=$(tmux show-environment -t "$session" DEV_SYNC_LABEL 2>/dev/null | cut -d= -f2-)

    render "${top_cmd:-?}" "${bot_cmd:-?}" "$restart_label" "${sync_label:-off}"

    # Single keypress, silent, raw (-s suppresses echo, -n1 reads one char).
    if (( restart_deadline > 0 )); then
      now=$(date +%s)
      if (( now >= restart_deadline )); then
        restart_both
        restart_deadline=$(( now + restart_seconds ))
        continue
      fi

      if ! IFS= read -rsn1 -t "$(( restart_deadline - now ))" key; then
        # A timeout is the normal automatic-restart path. If read was
        # interrupted early, loop around without restarting prematurely.
        now=$(date +%s)
        if (( now >= restart_deadline )); then
          restart_both
          restart_deadline=$(( now + restart_seconds ))
        fi
        continue
      fi
    else
      IFS= read -rsn1 key || { sleep 0.1; continue; }
    fi

    case "$key" in
      t|T) [[ -n "$top_id" ]] && tmux respawn-pane -k -t "$top_id" "$top_run" ;;
      b|B) [[ -n "$bot_id" ]] && tmux respawn-pane -k -t "$bot_id" "$bot_run" ;;
      a|A)
        restart_both
        if (( restart_deadline > 0 )); then
          restart_deadline=$(( $(date +%s) + restart_seconds ))
        fi
        ;;
      q|Q)
        tmux kill-session -t "$session"
        exit 0
        ;;
      *) : ;;  # ignore other keys
    esac
  done
fi

# ---- Arg parsing -------------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --pull)
      set_mode pull
      shift
      ;;
    --sync)
      set_mode sync
      shift
      ;;
    --no-pull|--no-sync)
      set_mode normal
      shift
      ;;
    --interval)
      [[ $# -ge 2 ]] || { echo "--interval needs SECONDS" >&2; exit 1; }
      if [[ ! "$2" =~ ^[0-9]+$ ]] || (( 10#$2 < 5 )); then
        echo "--interval needs a whole number of at least 5 seconds" >&2
        exit 1
      fi
      PULL_INTERVAL="$((10#$2))"
      shift 2
      ;;
    --repair)
      REPAIR_DEPENDENCIES=1
      shift
      ;;
    --no-repair)
      REPAIR_DEPENDENCIES=0
      shift
      ;;
    --override)
      [[ $# -ge 3 ]] || { echo "--override needs 2 args: CMD1 CMD2" >&2; exit 1; }
      TOP_CMD="$2"
      BOT_CMD="$3"
      shift 3
      ;;
    --restart)
      [[ $# -ge 2 ]] || { echo "--restart needs HOURS" >&2; exit 1; }
      set_restart_hours "$2" || exit 1
      shift 2
      ;;
    --no-restart)
      RESTART_HOURS="off"
      RESTART_SECONDS="0"
      shift
      ;;
    --uat-port)
      [[ $# -ge 2 ]] || { echo '--uat-port needs PORT' >&2; exit 1; }
      set_uat_port "$2"
      shift 2
      ;;
    --no-uat) UAT_PORT=0; shift ;;
    --attach-uat) ATTACH_UAT=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown arg: $1" >&2; usage >&2; exit 1 ;;
  esac
done

command -v tmux >/dev/null 2>&1 || { echo "dev-env: tmux not installed" >&2; exit 1; }
if [[ "$PULL_WATCH" == "1" ]]; then
  command -v git >/dev/null 2>&1 || { echo "dev-env: git not installed" >&2; exit 1; }
fi

SESSION="dev-$(basename "$PROJ_DIR" | tr -c '[:alnum:]_-' '_' | tr -s '_' | sed 's/^_//; s/_$//')"
if [[ "$ATTACH_UAT" == 1 ]]; then
  [[ "$UAT_PORT" != 0 ]] || { echo 'dev-env: --attach-uat needs a configured UAT port' >&2; exit 1; }
  tmux has-session -t "$SESSION" 2>/dev/null || { echo 'dev-env: no existing project session' >&2; exit 1; }
  BOT_ID=$(tmux show-environment -t "$SESSION" DEV_BOT_ID | cut -d= -f2-)
  [[ "$BOT_ID" =~ ^%[0-9]+$ ]] || { echo 'dev-env: existing session has no bottom pane' >&2; exit 1; }
  start_uat_listener
  tmux respawn-pane -k -t "$BOT_ID"
  printf 'dev-env: UAT listener enabled on port %s; bottom worker restarted\n' "$UAT_PORT"
  exit 0
fi
PROJECT_CACHE_KEY="$(printf '%s' "$(canonical_dir "$PROJ_DIR")" | cksum | awk '{ print $1 }')"
if [[ -n "${XDG_CACHE_HOME:-}" ]]; then
  CACHE_ROOT="$XDG_CACHE_HOME/dev-env"
elif [[ -n "${HOME:-}" ]]; then
  CACHE_ROOT="$HOME/.cache/dev-env"
else
  CACHE_ROOT="/tmp/dev-env-${UID:-user}"
fi
STATE_DIR="$CACHE_ROOT/${SESSION#dev-}-$PROJECT_CACHE_KEY"

# Start fresh if the same project already has a dev-env session or loose dev
# processes from a regular terminal.
cleanup_tmux_session "$SESSION"
cleanup_project_dev_processes "$PROJ_DIR"

if [[ "$REPAIR_DEPENDENCIES" == "1" ]]; then
  verify_dependency_cache "$PROJ_DIR"
  install_dependencies "$PROJ_DIR" "$STATE_DIR"
elif [[ "$SYNC_WATCH" == "1" ]] && dependencies_need_install "$PROJ_DIR" "$STATE_DIR"; then
  install_dependencies "$PROJ_DIR" "$STATE_DIR"
fi

# Controller command (properly quoted for tmux's shell invocation)
CTRL_CMD=$(printf '%q __controller %q %q %q' \
  "$SELF" "$SESSION" "$RESTART_SECONDS" "$RESTART_HOURS")

# Detect real terminal size; tmux new-session -d defaults to 80x24 otherwise,
# and the resulting proportional layout makes CTRL fatter after attach.
TERM_W=$(tput cols 2>/dev/null || echo 200)
TERM_H=$(tput lines 2>/dev/null || echo 50)

# Create session: pane 0 = controller (fills the whole window for now)
CTRL_ID=$(tmux new-session -d -s "$SESSION" -n dev -c "$PROJ_DIR" \
            -x "$TERM_W" -y "$TERM_H" \
            -P -F '#{pane_id}' "$CTRL_CMD")

start_uat_listener
if [[ "$UAT_PORT" == 0 ]]; then
  # Override a stale value inherited from the tmux server's environment.
  tmux set-environment -t "$SESSION" AGENT_TIME_UAT_PORT 0
fi

# Set up the status bar BEFORE splits so window_height reflects the final layout.
tmux set-option -t "$SESSION" status on
tmux set-option -t "$SESSION" status-position top
tmux set-option -t "$SESSION" status-style "bg=default,fg=default"
tmux set-option -t "$SESSION" status-left-length 80
tmux set-option -t "$SESSION" status-left "#[fg=cyan,bold] $(basename "$PROJ_DIR") #[fg=default,nobold]"
tmux set-option -t "$SESSION" status-right ""
tmux set-option -t "$SESSION" window-status-format " "
tmux set-option -t "$SESSION" window-status-current-format " "
tmux set-option -t "$SESSION" status-justify left

# Worker commands run through __runner so they survive exit/crash
TOP_RUN=$(printf '%q __runner %q %q' "$SELF" "$TOP_CMD" "$AUTO_RECOVER")
BOT_RUN=$(printf '%q __runner %q %q' "$SELF" "$BOT_CMD" "$AUTO_RECOVER")
PAUSED_RUN=$(printf '%q __paused' "$SELF")

# Split TOP off the controller. Size the NEW pane (TOP) so CTRL ends up at 1 row.
# `-l N` sets the new pane to N lines. Account for the 1-row pane border:
#   CTRL = WIN_H - TOP_SIZE - 1(border) → TOP_SIZE = WIN_H - 2 to leave CTRL=1.
WIN_H=$(tmux display-message -p -t "$CTRL_ID" '#{window_height}')
TOP_SIZE=$(( WIN_H > 4 ? WIN_H - 2 : WIN_H / 2 ))
TOP_ID=$(tmux split-window -t "$CTRL_ID" -v -l "$TOP_SIZE" -c "$PROJ_DIR" \
           -P -F '#{pane_id}' "$TOP_RUN")

# Split TOP evenly into TOP/BOTTOM (no -l → tmux splits 50/50)
BOT_ID=$(tmux split-window -t "$TOP_ID" -v -c "$PROJ_DIR" \
           -P -F '#{pane_id}' "$BOT_RUN")

# Stash IDs + cmds in session env so the controller can read them
tmux set-environment -t "$SESSION" DEV_TOP_ID  "$TOP_ID"
tmux set-environment -t "$SESSION" DEV_BOT_ID  "$BOT_ID"
tmux set-environment -t "$SESSION" DEV_TOP_CMD "$TOP_CMD"
tmux set-environment -t "$SESSION" DEV_BOT_CMD "$BOT_CMD"
tmux set-environment -t "$SESSION" DEV_TOP_RUN "$TOP_RUN"
tmux set-environment -t "$SESSION" DEV_BOT_RUN "$BOT_RUN"
tmux set-environment -t "$SESSION" DEV_PAUSED_RUN "$PAUSED_RUN"
tmux set-environment -t "$SESSION" DEV_RESTART_HOURS "$RESTART_HOURS"
if [[ "$SYNC_WATCH" == "1" ]]; then
  tmux set-environment -t "$SESSION" DEV_SYNC_LABEL "${PULL_INTERVAL}s"
elif [[ "$PULL_WATCH" == "1" ]]; then
  tmux set-environment -t "$SESSION" DEV_SYNC_LABEL "pull:${PULL_INTERVAL}s"
else
  tmux set-environment -t "$SESSION" DEV_SYNC_LABEL "off"
fi

if [[ "$PULL_WATCH" == "1" ]]; then
  if [[ "$SYNC_WATCH" == "1" ]]; then
    PULL_CMD=$(printf '%q __sync_watcher %q %q %q %q %q %q' \
      "$SELF" "$PROJ_DIR" "$PULL_REMOTE" "$PULL_BRANCH" "$PULL_INTERVAL" "$SESSION" "$STATE_DIR")
  else
    PULL_CMD=$(printf '%q __pull_watcher %q %q %q %q' \
      "$SELF" "$PROJ_DIR" "$PULL_REMOTE" "$PULL_BRANCH" "$PULL_INTERVAL")
  fi
  tmux split-window -t "$TOP_ID" -v -b -l 1 -c "$PROJ_DIR" \
    -P -F '#{pane_id}' "$PULL_CMD" >/dev/null
fi

# Focus the controller pane so single-keypress menu is live on attach
tmux select-window -t "$SESSION:dev"
tmux select-pane -t "$CTRL_ID"

# Attach (or switch, if already inside tmux)
if [[ -n "${TMUX:-}" ]]; then
  exec tmux switch-client -t "$SESSION"
else
  exec tmux attach-session -t "$SESSION"
fi
