{
  "version": 1,
  "aliases": {
    "local-dev": {
      "provider": "local",
      "path": ".env.local"
    },
    "convex-dev": {
      "provider": "convex",
      "deployment": "team-slug:project-slug:dev/user"
    },
    "vercel-preview": {
      "provider": "vercel",
      "project": "project-name",
      "scope": "team-slug",
      "environment": "preview"
    }
  },
  "checks": {
    "api-key": [
      "local-dev:API_KEY",
      "convex-dev:API_KEY",
      "vercel-preview:API_KEY"
    ]
  }
}
