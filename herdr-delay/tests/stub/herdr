#!/usr/bin/env bash
# Recording herdr stub. Real socket is never contacted.
# HD_STUB_DIR   where calls and prompts are recorded
# HD_STUB_PID   pid reported as the pane's foreground group leader
# HD_STUB_STATUS agent status to report
set -u
dir="${HD_STUB_DIR:?}"
printf '%s\n' "$*" >> "$dir/calls"
# a pid file, when present, wins over HD_STUB_PID so a test can simulate the
# agent being replaced between scheduling and delivery
pid="${HD_STUB_PID:-999}"
[ -f "$dir/pid" ] && pid=$(cat "$dir/pid")

case "$1 $2" in
  "pane process-info")
    printf '{"result":{"process_info":{"pane_id":"p","shell_pid":1,"foreground_process_group_id":%s,"foreground_processes":[{"pid":%s,"name":"agent"}]}}}\n' \
      "$pid" "$pid"
    ;;
  "agent list")
    printf '{"result":{"agents":[{"pane_id":"%s","agent":"stub","agent_status":"%s","cwd":"%s","foreground_cwd":"%s"}]}}\n' \
      "${HERDR_PANE_ID:-wT:p9}" "${HD_STUB_STATUS:-idle}" "$PWD" "$PWD"
    ;;
  "pane list")
    printf '{"result":{"panes":[{"pane_id":"%s"}]}}\n' "${HERDR_PANE_ID:-wT:p9}"
    ;;
  "agent get")
    status="${HD_STUB_STATUS:-idle}"
    [ -f "$dir/unblocked" ] && status=idle
    [ -f "$dir/prompts" ] && status=working
    printf '{"result":{"agent":{"agent_status":"%s"}}}\n' "$status"
    ;;
  "pane run")
    printf "%s\n" "$4" >> "$dir/prompts"
    # Current Herdr's successful pane run is silent.
    ;;
  "agent read")
    printf '{"result":{"text":%s}}\n' "$(python3 -c 'import json,sys,os
p=os.path.join(os.environ["HD_STUB_DIR"],"prompts")
print(json.dumps(open(p).read() if os.path.exists(p) else ""))')"
    ;;
  "agent wait")
    [ "$4" = --status ] && [ "$5" = idle ] || exit 1
    touch "$dir/unblocked"
    printf '{"result":{"type":"ok"}}\n'
    ;;
  "notification show")
    printf '{"result":{"type":"ok"}}\n'
    ;;
  *)
    printf '{"error":{"code":"not_implemented","message":"stub"}}\n'
    exit 1
    ;;
esac
